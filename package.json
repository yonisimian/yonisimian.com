{
  "name": "yonisimian.com",
  "version": "0.0.1",
  "description": "My personal website",
  "type": "module",
  "scripts": {
    "dev": "vite --open --host",
    "test": "vitest",
    "build": "vue-tsc --noEmit && vitest run && vite build",
    "serve": "vite preview",
    "update-dependencies": "npx npm-check-updates -u && pnpm install",
    "generate-local-trip": "ts-node --project tsconfig.node.json src/functions/static/trip/generateLocalTrip.cts",
    "generate-thumbnails": "python3 src/functions/static/generateThumbnails.py",
    "knip": "knip"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@types/node": "^26.6.6",
    "@unocss/preset-web-fonts": "^66.12.0",
    "@unocss/reset": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "knip": "^6.44.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "unocss": "^66.12.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-sitemap": "^0.8.2",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1"
}
